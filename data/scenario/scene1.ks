[tb_start_text mode=1 ]
Ah! There you are~! I was so excited about today that I ended up getting here way too early![p]
[_tb_end_text]

[tb_image_show  time="200"  storage="default/2.png"  width="315"  height="79"  x="70"  y="1420"  name="img_32"  ]
[tb_start_text mode=1 ]
Yeah. I've been waiting too. I wanted to see you even just a little sooner.[p]
[_tb_end_text]

[chara_mod  name="Natsume"  time="600"  cross="true"  storage="chara/1/25435_2.png"  ]
