[tb_show_message_window  ]
[tb_start_text mode=1 ]
I hope we can make this a summer we'll never forget.[p]
[_tb_end_text]

[tb_start_text mode=1 ]
Ah! There she is. Natsume.[p]
[_tb_end_text]

[tb_hide_message_window  ]
[tb_image_show  time="1001"  storage="default/from-PixAI-2053355333814845710.png"  width="768"  height="1280"  x="150"  y="110"  name="img_24"  ]
[tb_show_message_window  ]
[tb_start_text mode=1 ]
Somehow, she looks almost unfairly beautiful in the summer...[p]
[_tb_end_text]

[tb_start_text mode=1 ]
She notices me and walks over with a bright smile on her face.[p]
[_tb_end_text]

[tb_image_hide  time="1000"  ]
